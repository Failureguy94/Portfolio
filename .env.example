# ==============================================================================
# Portfolio Real-Time Telemetry API Credentials
# All platform data falls back gracefully to static data if keys are not set.
# ==============================================================================

# 1. GitHub API Token (Personal Access Token)
# Grants 5,000 requests/hour (vs 60/hour unauthenticated).
# Only public repo read access is needed (no special scopes).
VITE_GITHUB_TOKEN=

# 2. Codeforces API Key & Secret
# Used to generate authenticated SHA-512 signatures for user.info and user.rating.
# Generate yours at: https://codeforces.com/settings/api
VITE_CODEFORCES_API_KEY=
VITE_CODEFORCES_API_SECRET=

# 3. LeetCode Session Token
# Cookie / token for fetching live user problem split (easy/medium/hard) and global rank.
# Found in browser devtools cookies under "LEETCODE_SESSION".
VITE_LEETCODE_SESSION=

# 4. CodeChef API Key / OAuth Token
# Used to authenticate with CodeChef API if available.
VITE_CODECHEF_API_KEY=
