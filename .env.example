# Server-only settings for the /api functions. All optional: the site falls back
# to src/data/cp.json when a live fetch fails.
#
# Do NOT prefix these with VITE_. Anything starting with VITE_ that client code
# reads is compiled into the public JavaScript bundle.

# LeetCode session cookie. Not needed for the solved count, which is public.
LEETCODE_SESSION=

# CodeChef: either an official API bearer token, or a stats-service URL such as
# https://codechef-stats.tashif.codes/sarthak14313 . Without it the function
# reads the public profile page.
CODECHEF_API_KEY=

# Codeforces needs nothing: the site calls the public user.info and user.rating API.
